{
  "manifest_version": 3,
  "name": "フリマネージャー",
  "description": "メルカリ販売履歴を取得するための拡張の土台",
  "version": "0.1.0",
  "permissions": ["activeTab", "alarms", "storage", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://jp.mercari.com/*",
    "https://api.mercari.jp/*",
    "https://*.mercdn.net/*",
    "https://furimanager.com/*",
    "https://www.furimanager.com/*",
    "http://localhost:3000/*",
    "https://*.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://jp.mercari.com/mypage/listings/sold*"],
      "js": ["parser.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://jp.mercari.com/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://jp.mercari.com/sell*"],
      "js": ["content-script-relist.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://jp.mercari.com/user/profile/*"],
      "css": ["src/research-overlay.css"],
      "js": [
        "config.js",
        "src/research-api.js",
        "src/research-scraper.js",
        "src/research-stats.js",
        "src/research-simulator.js",
        "src/research-table.js",
        "src/research-overlay.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/research-page-fetcher.js"],
      "matches": ["https://jp.mercari.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
