{
  "manifest_version": 3,
  "name": "Furimanager (Dev)",
  "description": "Development manifest for local Furimanager testing",
  "version": "0.2.0",
  "permissions": ["activeTab", "alarms", "storage", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://jp.mercari.com/*",
    "https://api.mercari.jp/*",
    "https://*.mercdn.net/*",
    "https://*.supabase.co/*",
    "https://furimanager.com/*",
    "https://www.furimanager.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.vercel.app/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://jp.mercari.com/mypage/listings/sold*"],
      "js": ["parser.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://jp.mercari.com/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://jp.mercari.com/sell*"],
      "js": ["content-script-relist.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://jp.mercari.com/*"],
      "css": ["src/research-overlay.css"],
      "js": [
        "config.js",
        "src/research-api.js",
        "src/research-scraper.js",
        "src/research-simulator.js",
        "src/research-table.js",
        "src/research-overlay.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://furimanager.com/*",
        "https://www.furimanager.com/*",
        "https://*.vercel.app/*"
      ],
      "js": ["src/extension-installed-detector.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/research-page-fetcher.js", "icons/icon-48.png"],
      "matches": ["https://jp.mercari.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
